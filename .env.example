# Copy to .env for the API. No values here are credentials.
MONGODB_URI=mongodb://127.0.0.1:27017/saferide_dev
PORT=4000
WEB_ORIGIN=http://127.0.0.1:5173
NODE_ENV=development
# Production examples and deployment notes: docs/production.env.example.
# For an HTTPS single-origin build, set SERVE_WEB_DIST=true and configure
# API_ALLOWED_HOSTS only for additional exact upstream Host values.
SERVE_WEB_DIST=false
API_ALLOWED_HOSTS=
# Optional public business phone, E.164 format. Leave unset until verified.
PUBLIC_PHONE=
PUBLIC_EMAIL=
BUSINESS_NAME=SafeRide
PUBLIC_CONTACT_NAME=
PUBLIC_WHATSAPP=
PUBLIC_AREA=
PUBLIC_HOURS=
# Optional Gmail delivery for contact enquiries. Use a Gmail App Password,
# not the Gmail account password. Keep these values private in .env.
ENQUIRY_EMAIL_TO=
SMTP_USER=
SMTP_APP_PASSWORD=
# Optional compatible HTTPS reverse-geocoding endpoint (see README). Blank disables lookups.
REVERSE_GEOCODER_API_KEY=
REVERSE_GEOCODER_URL=
# Optional HeiGIT openrouteservice API key. Without it, bookings remain open
# and the customer sees “Distance unavailable — owner will confirm the fare.”
# Review provider terms, usage limits and attribution before enabling it.
ORS_API_KEY=
