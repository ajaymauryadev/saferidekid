# Example only. Set values in the hosting provider's secret manager. Never commit real values.
NODE_ENV=production
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.example/saferide?retryWrites=true&w=majority
PORT=4000
WEB_ORIGIN=https://saferidekid-ui-one.vercel.app
# Comma-separated exact Host values reaching Express. Include the public host and,
# for an external /api rewrite, the API provider host if it forwards that Host.
API_ALLOWED_HOSTS=
# true: one Express origin serves built React and /api; false: separate Vercel frontend.
SERVE_WEB_DIST=true

# First-time private bootstrap only; provide to the one-time command, then remove.
# BOOTSTRAP_OWNER_NAME=
# BOOTSTRAP_OWNER_MOBILE=
# BOOTSTRAP_OWNER_PASSWORD=

# One-time business configuration for npm run seed:dev. Do not rerun with stale values.
# BUSINESS_NAME=SafeRide
# PUBLIC_PHONE=+91...
# PUBLIC_WHATSAPP=+91...
# PUBLIC_AREA=
# PUBLIC_HOURS=
