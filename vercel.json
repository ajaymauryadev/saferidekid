{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "MONGOMS_DISABLE_POSTINSTALL=1 npm ci --include=dev",
  "buildCommand": "npm run build -w @saferide/shared && npm run build -w @saferide/web -- --mode vercel",
  "outputDirectory": "apps/web/dist",
  "headers": [
    { "source": "/api/:path*", "headers": [{ "key": "Cache-Control", "value": "private, no-store" }] }
  ],
  "rewrites": [
    { "source": "/api/live", "destination": "https://replace-with-render-host.invalid/socket.io/" },
    { "source": "/api/:path*", "destination": "https://replace-with-render-host.invalid/api/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
